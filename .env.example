# Copy to .env (gitignored) and fill in. Every value is optional for local runs.
# On Hugging Face Spaces, set the same names as Space secrets instead.

# Forecast log for /monitoring. Use an external Postgres in production (free tier,
# e.g. Neon or Supabase), because Space storage is wiped on restart.
# Default: local SQLite at data/aurora.sqlite.
DATABASE_URL=

# Error reporting (Sentry free plan). Empty = off.
SENTRY_DSN=
# Any random string. Opening /api/sentry-test?key=<it> raises a test error for Sentry.
# Empty = the route returns 404.
SENTRY_TEST_KEY=

# Background jobs that log forecasts and observed Kp. 1 = on (default), 0 = off.
SCHEDULER=1

# Optional, paid: Claude API key for an LLM-written briefing. Without it the free
# template text is used, which is how the deployed app runs.
ANTHROPIC_API_KEY=
# Max LLM briefings per UTC day; beyond that the template is used.
BRIEFING_DAILY_LIMIT=300
# SQLite cache of LLM briefings (default: data/briefings.sqlite).
# BRIEFING_DB=data/briefings.sqlite
