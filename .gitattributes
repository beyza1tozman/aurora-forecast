# Normalize all text files to LF in the repo and in the working tree,
# regardless of core.autocrlf, so scripts run in the Linux Docker container.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.parquet binary
*.bsp binary
*.woff binary
*.woff2 binary
